# Milestone M5 acceptance (threads): a worker from a file and one from a
# code string, a Channel carrying numbers, strings, tables and a closure
# each way, performAtomic, and a thread that fails reaching threaderror.
# Quits with exit code 8 when everything arrived.
module^ threadtest

import^ love.thread
import^ love.graphics
import^ love.event
import^ love.timer

let^ jobs = love.thread.getChannel("jobs")
let^ results = love.thread.getChannel("results")
let^ worker = love.thread.newThread("worker.lh")
let^ echo = love.thread.newThread("import^ love.thread\nlet^ args = ...\nlet^ f = args[1]\nlet^ out = love.thread.getChannel(\"results\")\nif^ f fits^ p^number^ -> number^; { out.push($\"closure says {f(20)}\") }\nout.push(\"echo done\")\n")
let^ broken = love.thread.newThread("let^ t = {}\npanic^ \"boom from a thread\"\n")

var^ frames = 0
var^ received : t^{...:string^} = {}
var^ errors = 0
var^ errorText = ""

public^let^ load = p^ {
    worker.start("alpha", 3)
    echo.start(f^n:number^ -> number^ { return^ n + 22 })
    broken.start()
    jobs.push(7)
    jobs.push("hello")
    jobs.push({ x = 1.5, y = 2.5 })
    jobs.supply("stop")
    print($"threads running: worker={worker.isRunning()} echo={echo.isRunning()}")
}

public^let^ threaderror = p^thread:love.thread.Thread, message:string^ {
    errors := errors + 1
    errorText := message
    print($"threaderror: {message}")
}

public^let^ update = p^dt:number^ {
    frames := frames + 1
    repeat^ {
        let^ got = results.pop()
        if^ got fits^ nil^ { break^ }
        if^ got fits^ string^ {
            received.push^(got)
        elseif^ got fits^ number^:
            received.push^($"number {got}")
        elseif^ got fits^ t^{ sum : number^, from : string^ }:
            received.push^($"table sum={got.sum} from {got.from}")
        }
    }
    if^ !worker.isRunning() and^ !echo.isRunning() and^ !broken.isRunning() and^ errors > 0 {
        worker.wait()
        echo.wait()
        broken.wait()
        var^ atomic = 0
        results.performAtomic(p^c:love.thread.Channel, extra:any^ {
            c.push("atomic")
            if^ extra fits^ number^ { atomic := c.getCount() + extra }
        }, 100)
        print($"atomic count {atomic}, pending {results.getCount()}, popped {results.pop()}")
        for^ line in^ received { print($"  {line}") }
        let^ err = broken.getError()
        print($"broken error: {err}")
        let^ ok = received.length^ = 7 and^ atomic = 101 and^ err fits^ string^ and^ worker.getError() fits^ nil^
        if^ ok { love.event.quit(8) else^: love.event.quit(1) }
    }
    if^ frames > 600 { love.event.quit(2) }
}

public^let^ draw = p^ {
    love.graphics.print($"M5 threads: frame {frames}, received {received.length^}, errors {errors}", 10, 10)
}
