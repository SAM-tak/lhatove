# love.image and the Font half of love.graphics -- the L^port of
# testing/tests/image.lua and font.lua, for what is bound (compressed
# data, encode/paste, Rasterizer and GlyphData wait for theirs).
module^suite.tests.image

import^love.image
import^love.graphics

let^test = require^"../lib/test.lh"

public^let^run = p^{
    test.begin("love.image")

    let^picture = love.image.newImageData("assets/love.png") catch^nil^
    if^picture = nil^{
        test.isTrue("newImageData reads a png", false^)
    else^:
        test.text("type", "ImageData", picture.type())
        test.isTrue("the image has a width", picture.getWidth() > 0)
        test.isTrue("the image has a height", picture.getHeight() > 0)
        let^w, h = picture.getDimensions()
        test.number("getDimensions agrees on width", picture.getWidth(), w)
        test.number("getDimensions agrees on height", picture.getHeight(), h)
    }

    # a blank image is transparent black, and a written pixel reads back
    let^blank = love.image.newImageData(8, 8)
    do^{
        let^r, g, b, a = blank.getPixel(0, 0)
        test.isTrue("a blank pixel is transparent black", r = 0 and^g = 0 and^b = 0 and^a = 0)
        blank.setPixel(1, 1, 1, 0.5, 0.25, 1)
        let^r2, g2, b2, a2 = blank.getPixel(1, 1)
        test.number("the written red", 1, r2)
        test.near("the written green", 0.5, g2, 0.01)
        test.near("the written blue", 0.25, b2, 0.01)
        test.number("the written alpha", 1, a2)

        # mapPixel walks every pixel
        blank.mapPixel(f^x:number^, y:number^, r:number^, g:number^, b:number^, a:number^-> (number^, number^, number^, number^) {
            return^0, 1, 0, 1
        })
        let^r3, g3, b3, a3 = blank.getPixel(4, 4)
        test.isTrue("mapPixel wrote every pixel", r3 = 0 and^g3 = 1 and^b3 = 0 and^a3 = 1)
    }

    test.begin("love.graphics (fonts)")

    let^font = love.graphics.newFont(12)
    test.text("type", "Font", font.type())
    test.isTrue("the font has a height", font.getHeight() > 0)
    test.isTrue("the font has a line height", font.getLineHeight() > 0)
    test.isTrue("a longer string is wider", font.getWidth("hello world") > font.getWidth("hello"))
    test.number("an empty string has no width", 0, font.getWidth(""))

    let^ttf = love.graphics.newFont("assets/font.ttf", 24) catch^nil^
    if^ttf = nil^{
        test.isTrue("newFont reads a ttf", false^)
    else^:
        test.isTrue("the bigger font is taller", ttf.getHeight() > font.getHeight())
    }

    # the module's current font is one of these
    let^before = love.graphics.getFont()
    love.graphics.setFont(font)
    test.isTrue("setFont round trips", love.graphics.getFont() = font)
    love.graphics.setFont(before)
}
