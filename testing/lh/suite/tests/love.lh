# love (the module itself) -- the L^port of testing/tests/love.lua.
module^suite.tests.love

import^love
import^love.system

let^test = require^"../lib/test.lh"

public^let^run = p^{
    test.begin("love")

    let^major, minor, revision, codename = love.getVersion()
    test.number("version major", 12, major)
    test.isTrue("version minor is a number", minor >= 0)
    test.isTrue("version revision is a number", revision >= 0)
    test.isTrue("the version has a codename", codename.length > 0)

    # the parent module and one under it in the same unit (lhat 995d0e8)
    test.isTrue("love and love.system import together", love.system.getProcessorCount() >= 1)
}
